---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Pricing from "../components/Pricing.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import Faq from "../components/Faq.astro";
import CTA from "../components/CTA.astro";
import { GROOM_INCLUDES, SITE } from "../consts";
---

<BaseLayout
  title="Dog Grooming Services & Prices"
  description="Dog grooming services and prices at Patty's Pup Cuts in Morrisville, PA. Full grooming by size from $50 — bath, blow dry, haircut, nail trim and brush out — plus à la carte nail trims, de-shedding, and more."
>
  <PageHeader
    eyebrow="Services & prices"
    title="Everything your pup needs to look and feel their best"
    subtitle="A professional, home-based salon that cares about great grooming and your pet's well-being. Individual services can be booked on their own or combined."
  />

  <!-- Pricing -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-ink sm:text-4xl">Full grooming, priced by size</h2>
        <p class="mt-3 text-body">
          Every full groom is a complete spa day and includes:
          <span class="font-semibold text-ink">{GROOM_INCLUDES.join(", ")}.</span>
        </p>
      </div>
      <div class="mt-12">
        <Pricing />
      </div>
    </div>
  </section>

  <!-- À la carte -->
  <section class="bg-cloud py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-script text-2xl text-pink">À la carte</p>
        <h2 class="mt-1 text-3xl font-extrabold text-ink sm:text-4xl">Individual services</h2>
        <p class="mt-3 text-body">
          Need just a bath, a nail trim, or a de-shed between full grooms? Individual services are priced
          separately and can be added to any appointment — just ask when you book.
        </p>
      </div>
      <div class="mt-12">
        <ServicesGrid />
      </div>
    </div>
  </section>

  <!-- Natural products note -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-4xl rounded-3xl border border-line bg-blush-soft px-6 py-10 text-center sm:px-10">
      <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">Gentle, 100% natural products</h2>
      <p class="mx-auto mt-3 max-w-2xl leading-relaxed text-body">
        We use 100% natural shampoos and conditioners on every pup. Now more than ever, your pet's safety
        and comfort are our top priorities — and we're a home-based salon, so we're never trying to rush a
        large number of dogs through like the big-chain groomers.
      </p>
      <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-pink">By appointment only · {SITE.address.landmark}</p>
    </div>
  </section>

  <!-- FAQ teaser -->
  <section class="bg-cloud py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-extrabold text-ink sm:text-4xl">Common questions</h2>
        <p class="mt-3 text-body">A few things pet parents often ask before their first visit.</p>
      </div>
      <div class="mt-10">
        <Faq limit={4} />
      </div>
      <div class="mt-8 text-center">
        <a href="/faq/" class="inline-flex items-center gap-1 font-bold text-pink hover:text-pink-600">
          Read all FAQs
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4L11.58 10 7.3 5.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <CTA title="Book your pup's spa day" />
</BaseLayout>
