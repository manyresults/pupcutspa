---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../consts";
---

<BaseLayout
  title="Contact & Booking"
  description="Book an appointment at Patty's Pup Cuts in Morrisville, PA. Message us on Facebook, call or text (267) 499-6674, or send us a message. Across from the Morrisville Dog Park."
>
  <PageHeader
    eyebrow="Get in touch"
    title="Let's book your pup's appointment"
    subtitle="The fastest way to book is on Facebook — but no Facebook? No problem. Call, text, or drop us a line and we'll get right back to you."
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <!-- Contact methods -->
      <div>
        <a
          href={SITE.social.facebook}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3 rounded-2xl bg-pink px-6 py-4 text-lg font-bold text-white shadow-lg shadow-pink/25 transition-colors hover:bg-pink-600"
        >
          <svg class="h-7 w-7 flex-none" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
          </svg>
          Message us on Facebook
        </a>

        <dl class="mt-8 space-y-6">
          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-blush-soft text-pink" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.28 6.72 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.37c0-.51-.35-.96-.85-1.09l-4.42-1.1a1.12 1.12 0 0 0-1.17.4l-.97 1.29a12.03 12.03 0 0 1-5.31-5.31l1.29-.97c.35-.26.5-.72.4-1.17l-1.1-4.42a1.12 1.12 0 0 0-1.1-.85H4.5A2.25 2.25 0 0 0 2.25 6.75Z" /></svg>
            </span>
            <div>
              <dt class="text-sm font-bold uppercase tracking-wide text-ink">Call or text</dt>
              <dd class="mt-1 space-y-0.5 text-body">
                <a href={SITE.phoneHref} class="block font-semibold text-pink hover:text-pink-600">{SITE.phoneDisplay}</a>
                <a href={SITE.phone2Href} class="block font-semibold text-pink hover:text-pink-600">{SITE.phone2Display}</a>
              </dd>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-blush-soft text-pink" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            </span>
            <div>
              <dt class="text-sm font-bold uppercase tracking-wide text-ink">Email</dt>
              <dd class="mt-1 text-body">
                <a href={`mailto:${SITE.email}`} class="font-semibold text-pink hover:text-pink-600 break-all">{SITE.email}</a>
              </dd>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <span class="flex h-11 w-11 flex-none items-center justify-center rounded-full bg-blush-soft text-pink" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.14-7.5 11.25-7.5 11.25S4.5 17.64 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            </span>
            <div>
              <dt class="text-sm font-bold uppercase tracking-wide text-ink">Visit</dt>
              <dd class="mt-1 text-body">
                {SITE.address.street}<br />
                {SITE.address.city}, {SITE.address.state} {SITE.address.zip}<br />
                <span class="block text-sm text-body/80">{SITE.address.landmark}</span>
                <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="mt-2 flex w-max items-center gap-1 font-bold text-pink hover:text-pink-600">
                  Get directions
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4L11.58 10 7.3 5.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd" /></svg>
                </a>
              </dd>
            </div>
          </div>
        </dl>

        <p class="mt-8 rounded-2xl bg-blush-soft px-5 py-4 text-sm leading-relaxed text-body">
          <span class="font-bold text-ink">By appointment only.</span> Please note: appointments 10 minutes
          late or more without notice are considered canceled — it helps us give every pup our full,
          unhurried attention.
        </p>
      </div>

      <!-- Message form (mailto-based, no third-party service) -->
      <div class="rounded-3xl border border-line bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-2xl font-extrabold text-ink">Send us a message</h2>
        <p class="mt-2 text-sm text-body">
          Tell us about your pup and what they need, and we'll get back to you to set up a time.
        </p>
        <form id="contact-form" class="mt-6 space-y-4">
          <div>
            <label for="name" class="block text-sm font-bold text-ink">Your name</label>
            <input id="name" name="name" type="text" required autocomplete="name"
              class="mt-1 w-full rounded-xl border border-line bg-white px-4 py-2.5 text-ink outline-none focus:border-pink focus:ring-2 focus:ring-pink/20" />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="phone" class="block text-sm font-bold text-ink">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel"
                class="mt-1 w-full rounded-xl border border-line bg-white px-4 py-2.5 text-ink outline-none focus:border-pink focus:ring-2 focus:ring-pink/20" />
            </div>
            <div>
              <label for="dog" class="block text-sm font-bold text-ink">Dog's name &amp; breed</label>
              <input id="dog" name="dog" type="text"
                class="mt-1 w-full rounded-xl border border-line bg-white px-4 py-2.5 text-ink outline-none focus:border-pink focus:ring-2 focus:ring-pink/20" />
            </div>
          </div>
          <div>
            <label for="message" class="block text-sm font-bold text-ink">What does your pup need?</label>
            <textarea id="message" name="message" rows="4" required
              class="mt-1 w-full rounded-xl border border-line bg-white px-4 py-2.5 text-ink outline-none focus:border-pink focus:ring-2 focus:ring-pink/20"></textarea>
          </div>
          <button type="submit"
            class="w-full rounded-full bg-pink px-6 py-3 text-base font-bold text-white shadow-lg shadow-pink/25 transition-colors hover:bg-pink-600">
            Send message
          </button>
          <p class="text-center text-xs text-body/70">
            This opens your email app with the details filled in. Prefer to talk?{" "}
            <a href={SITE.phoneHref} class="font-semibold text-pink hover:text-pink-600">Call or text us</a>.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ email: SITE.email }}>
    const form = document.getElementById("contact-form");
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = data.get("name") || "";
      const phone = data.get("phone") || "";
      const dog = data.get("dog") || "";
      const message = data.get("message") || "";
      const subject = `Grooming inquiry from ${name}`;
      const body =
        `Name: ${name}\n` +
        `Phone: ${phone}\n` +
        `Dog (name & breed): ${dog}\n\n` +
        `${message}\n`;
      window.location.href =
        `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  </script>
</BaseLayout>
