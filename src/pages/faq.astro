---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Faq from "../components/Faq.astro";
import CTA from "../components/CTA.astro";
import { FAQS } from "../consts";

// Build FAQPage structured data (strip internal ASSUMPTION notes).
const clean = (a: string) => a.replace(/\s*\(ASSUMPTION[^)]*\)/gi, "").trim();
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQS.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: clean(f.a) },
  })),
};
---

<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about grooming at Patty's Pup Cuts in Morrisville, PA — booking, first visits, vaccinations, our cancellation policy, natural products, and more."
>
  <PageHeader
    eyebrow="Good to know"
    title="Frequently asked questions"
    subtitle="New to Patty's Pup Cuts? Here's everything you need to know before your first appointment."
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <Faq />
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-body">
        Still have a question? We're happy to help — just reach out and we'll get right back to you.
      </p>
    </div>
  </section>

  <CTA title="Have a question? Just ask" subtitle="Message us on Facebook, or call or text — we'll help you find the right appointment for your pup." />

  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
