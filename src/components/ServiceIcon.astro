---
/**
 * ServiceIcon.astro — inline, dependency-free SVG icons for services.
 * `name` maps to the `icon` field in SERVICES (src/consts.ts).
 * Icons inherit `currentColor` so they take the surrounding text color.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = "h-7 w-7" } = Astro.props;
---

{
  name === "scissors" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="6" cy="6" r="3" />
      <circle cx="6" cy="18" r="3" />
      <line x1="20" y1="4" x2="8.12" y2="15.88" />
      <line x1="14.47" y1="14.48" x2="20" y2="20" />
      <line x1="8.12" y1="8.12" x2="12" y2="12" />
    </svg>
  )
}
{
  name === "bath" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2" />
      <line x1="3" y1="12" x2="21" y2="12" />
      <path d="M5 12v3a4 4 0 0 0 4 4h6a4 4 0 0 0 4-4v-3" />
      <line x1="7" y1="21" x2="6" y2="22.5" />
      <line x1="17" y1="21" x2="18" y2="22.5" />
    </svg>
  )
}
{
  name === "paw" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <ellipse cx="6" cy="10" rx="1.8" ry="2.4" />
      <ellipse cx="10" cy="6.5" rx="1.8" ry="2.4" />
      <ellipse cx="14" cy="6.5" rx="1.8" ry="2.4" />
      <ellipse cx="18" cy="10" rx="1.8" ry="2.4" />
      <path d="M12 12c2.4 0 4.5 1.6 4.5 3.8 0 1.8-1.6 2.7-3.2 2.7-.9 0-1.2.4-1.3.6-.1-.2-.4-.6-1.3-.6-1.6 0-3.2-.9-3.2-2.7C7.5 13.6 9.6 12 12 12Z" />
    </svg>
  )
}
{
  name === "brush" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="6" y="3" width="12" height="7" rx="3" />
      <line x1="9" y1="10" x2="9" y2="15" />
      <line x1="12" y1="10" x2="12" y2="16" />
      <line x1="15" y1="10" x2="15" y2="15" />
      <path d="M12 16v3a2 2 0 0 1-2 2H8" />
    </svg>
  )
}
{
  name === "ear" && (
    <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 8.5a6 6 0 0 1 12 0c0 3-2.2 4.2-3.5 5.3-1 .9-1.2 1.7-1.4 2.7-.2 1.1-.9 2-2.1 2A2.5 2.5 0 0 1 8.5 16" />
      <path d="M9.5 8.5a2.5 2.5 0 0 1 5 0" />
    </svg>
  )
}
{
  name === "heart" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 20s-7-4.35-9.33-8.6C1.1 8.4 2.6 5.5 5.6 5.5c1.8 0 3.1 1 4.4 2.6C11.3 6.5 12.6 5.5 14.4 5.5c3 0 4.5 2.9 2.93 5.9C19 15.65 12 20 12 20Z" />
    </svg>
  )
}
