---
/**
 * Logo.astro — the Patty's Pup Cuts brand lockup (real logo image).
 * `variant="color"` for light backgrounds, `variant="white"` for dark/pink.
 */
import { Image } from "astro:assets";
import { SITE } from "../consts";
import logoColor from "../assets/logo-pattys-pup-cuts.png";
import logoWhite from "../assets/logo-pattys-pup-cuts-white.png";

interface Props {
  class?: string;
  variant?: "color" | "white";
}
const { class: className = "h-12 w-auto", variant = "color" } = Astro.props;
const src = variant === "white" ? logoWhite : logoColor;
---

<Image
  src={src}
  alt={`${SITE.name} logo`}
  class={className}
  widths={[160, 240, 320]}
  sizes="240px"
  loading="eager"
/>
