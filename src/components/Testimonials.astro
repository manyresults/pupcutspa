---
import { TESTIMONIALS } from "../consts";
interface Props {
  /** Cap how many reviews to show (e.g. 3 on the home page). */
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? TESTIMONIALS.slice(0, limit) : TESTIMONIALS;
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    list.map((t) => (
      <figure class="flex h-full flex-col rounded-3xl border border-line bg-white p-6 shadow-sm">
        <div class="flex gap-0.5 text-pink" aria-label="5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => (
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 1.5l2.6 5.3 5.9.86-4.25 4.14 1 5.87L10 15.9l-5.25 2.77 1-5.87L1.5 8.66l5.9-.86L10 1.5Z" />
            </svg>
          ))}
        </div>
        <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-body">“{t.quote}”</blockquote>
        <figcaption class="mt-5 border-t border-line pt-4">
          <span class="block font-bold text-ink">{t.author}</span>
          {t.date && <span class="block text-xs text-body/70">{t.date}</span>}
        </figcaption>
      </figure>
    ))
  }
</div>
