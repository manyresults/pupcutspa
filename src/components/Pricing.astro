---
import { PRICING, GROOM_INCLUDES, SITE } from "../consts";
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
  {
    PRICING.map((tier) => (
      <div
        class:list={[
          "relative flex flex-col rounded-3xl border bg-white p-6 text-center shadow-sm",
          tier.popular ? "border-pink ring-2 ring-pink/20" : "border-line",
        ]}
      >
        {tier.popular && (
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-pink px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
            Most booked
          </span>
        )}
        <h3 class="text-lg font-bold text-ink">{tier.size}</h3>
        <p class="mt-3 font-display text-4xl font-extrabold text-pink">{tier.price}</p>
        {tier.note && <p class="mt-1 text-xs text-body/80">{tier.note}</p>}
        <ul class="mt-5 space-y-2 text-left text-sm text-body">
          {GROOM_INCLUDES.map((item) => (
            <li class="flex items-start gap-2">
              <svg class="mt-0.5 h-4 w-4 flex-none text-pink" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
              </svg>
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<p class="mt-6 text-center text-sm text-body">
  Not sure which size fits your pup? <a href={SITE.phoneHref} class="font-bold text-pink hover:text-pink-600">Give us a call</a> and we'll help you figure it out.
  Individual services are available for separate prices and may be combined.
</p>
