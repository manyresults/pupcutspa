---
import { SITE, NAV } from "../consts";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/75">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-4">
    <!-- Brand + blurb -->
    <div class="md:col-span-2">
      <Logo class="h-16 w-auto" variant="white" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/70">
        A home-based, mother-and-daughter dog grooming salon in {SITE.address.city}, {SITE.address.state}.
        Calm, one-on-one care and 100% natural shampoos — every pup treated like family.
      </p>
      <a
        href={SITE.social.facebook}
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-pink"
        rel="noopener"
        target="_blank"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
        </svg>
        Follow &amp; book on Facebook
      </a>
    </div>

    <!-- Nav -->
    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white">Explore</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-white/70 transition-colors hover:text-pink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Contact -->
    <div>
      <h2 class="font-display text-sm font-bold uppercase tracking-wider text-white">Visit &amp; Call</h2>
      <address class="mt-4 space-y-2 text-sm not-italic text-white/70">
        <p>
          <a href={SITE.mapsUrl} class="transition-colors hover:text-pink" target="_blank" rel="noopener">
            {SITE.address.street}<br />
            {SITE.address.city}, {SITE.address.state} {SITE.address.zip}
          </a>
          <span class="block text-xs text-white/50">{SITE.address.landmark}</span>
        </p>
        <p>
          <a href={SITE.phoneHref} class="transition-colors hover:text-pink">{SITE.phoneDisplay}</a>
          <span class="text-white/40"> · </span>
          <a href={SITE.phone2Href} class="transition-colors hover:text-pink">{SITE.phone2Display}</a>
        </p>
        <p>
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-pink">{SITE.email}</a>
        </p>
        <p class="pt-1 text-xs font-semibold uppercase tracking-wide text-pink">By appointment only</p>
      </address>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-white/50 sm:flex-row sm:px-6">
      <p>&copy; {year} {SITE.legalName}. All rights reserved.</p>
      <p>Proudly women-owned · Serving Morrisville &amp; Lower Bucks County, PA</p>
    </div>
  </div>
</footer>
