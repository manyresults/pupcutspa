---
import { SITE, NAV } from "../consts";
import Logo from "./Logo.astro";

// Normalize paths so "/services" and "/services/" both match.
const norm = (p: string) => (p !== "/" ? p.replace(/\/$/, "") : p);
const current = norm(Astro.url.pathname);
---

<!-- Announcement strip -->
<div class="bg-pink text-white">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-3 gap-y-1 px-4 py-1.5 text-center text-xs font-semibold sm:text-sm">
    <span>🐾 By appointment only · {SITE.address.landmark}</span>
    <span class="hidden sm:inline" aria-hidden="true">·</span>
    <a href={SITE.phoneHref} class="underline decoration-white/40 underline-offset-2 hover:decoration-white">
      Call or text {SITE.phoneDisplay}
    </a>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center" aria-label={`${SITE.name} — home`}>
      <Logo class="h-11 w-auto sm:h-14" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => {
          const active = current === norm(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3 py-2 text-sm font-bold transition-colors",
                active ? "text-pink" : "text-ink hover:text-pink",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={SITE.social.facebook}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2 rounded-full bg-pink px-4 py-2 text-sm font-bold text-white shadow-sm transition-colors hover:bg-pink-600 sm:inline-flex"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
        </svg>
        Book on Facebook
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex items-center justify-center rounded-md p-2 text-ink md:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden border-t border-line bg-white md:hidden" aria-label="Mobile">
    <ul class="space-y-1 px-4 py-3">
      {
        NAV.map((item) => {
          const active = current === norm(item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? "page" : undefined}
                class:list={[
                  "block rounded-lg px-3 py-2 text-base font-bold",
                  active ? "bg-blush-soft text-pink" : "text-ink hover:bg-blush-soft",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="grid grid-cols-2 gap-2 pt-2">
        <a
          href={SITE.social.facebook}
          target="_blank"
          rel="noopener"
          class="block rounded-full bg-pink px-4 py-2 text-center text-base font-bold text-white"
        >
          Facebook
        </a>
        <a
          href={SITE.phoneHref}
          class="block rounded-full border-2 border-pink px-4 py-2 text-center text-base font-bold text-pink"
        >
          Call
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
