---
import { FAQS } from "../consts";
interface Props {
  /** Cap the number of questions (e.g. a teaser). */
  limit?: number;
}
const { limit } = Astro.props;
// Strip internal "(ASSUMPTION …)" notes from the public-facing answer text.
const clean = (a: string) => a.replace(/\s*\(ASSUMPTION[^)]*\)/gi, "").trim();
const list = (limit ? FAQS.slice(0, limit) : FAQS).map((f) => ({ q: f.q, a: clean(f.a) }));
---

<div class="mx-auto max-w-3xl divide-y divide-line overflow-hidden rounded-3xl border border-line bg-white">
  {
    list.map((f) => (
      <details class="group px-6 py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-bold text-ink">
          {f.q}
          <svg class="h-5 w-5 flex-none text-pink transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
          </svg>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-body">{f.a}</p>
      </details>
    ))
  }
</div>
